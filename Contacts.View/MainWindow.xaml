<Window
  x:Class="Contacts.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewmodel="clr-namespace:Contacts.ViewModel"
  xmlns:converters="clr-namespace:Contacts.Converters"
  xmlns:controls="clr-namespace:Contacts.Controls"
  mc:Ignorable="d"
  Title="Контакты"
  Height="500"
  Width="800"
  WindowStartupLocation="CenterScreen"
>
  <Window.Resources>
    <!-- Конвертер для видимости кнопки Apply -->
    <converters:VisibilityConverter x:Key="VisibilityConverter" />
    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="25" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Шаблон элемента списка контактов -->
    <DataTemplate x:Key="ContactTemplate">
      <StackPanel Margin="3">
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="{Binding PhoneNumber}" FontSize="10" Foreground="#FF666666" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="0">
    <!-- Определяем колонки с GridSplitter -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="200" />
      <ColumnDefinition Width="5" />
      <!-- Ширина сплиттера -->
      <ColumnDefinition Width="2*" MinWidth="300" />
    </Grid.ColumnDefinitions>
    <!-- ЛЕВАЯ ПАНЕЛЬ - Список контактов (светло-серый фон) -->
    <Grid Grid.Column="0" Background="#F8F8F8">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Заголовок списка -->
        <TextBlock
          Grid.Row="0"
          Text="Список контактов"
          FontWeight="Bold"
          FontSize="14"
          Margin="0,0,0,8"
        />
        <!-- Список контактов -->
        <ListBox
          Grid.Row="1"
          ItemsSource="{Binding Contacts}"
          SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
          ItemTemplate="{StaticResource ContactTemplate}"
          Margin="0,0,0,8"
        />
        <!-- Кнопки управления -->
        <UniformGrid Grid.Row="2" Columns="3">
          <Button
            Command="{Binding AddCommand}"
            Margin="0,0,3,0"
            Style="{StaticResource ActionButtonStyle}"
            ToolTip="Добавить контакт"
          >
            <StackPanel Orientation="Horizontal">
              <Image
                Width="16"
                Height="16"
                Margin="0,0,4,0"
                Source="pack://application:,,,/Assets/add_contact_32x32.png"
              />
              <TextBlock Text="Add" />
            </StackPanel>
          </Button>
          <Button
            Command="{Binding EditCommand}"
            Margin="0,0,3,0"
            Style="{StaticResource ActionButtonStyle}"
            ToolTip="Редактировать контакт"
          >
            <StackPanel Orientation="Horizontal">
              <Image
                Width="16"
                Height="16"
                Margin="0,0,4,0"
                Source="pack://application:,,,/Assets/edit_contact_32x32.png"
              />
              <TextBlock Text="Edit" />
            </StackPanel>
          </Button>
          <Button
            Command="{Binding RemoveCommand}"
            Style="{StaticResource ActionButtonStyle}"
            ToolTip="Удалить контакт"
          >
            <StackPanel Orientation="Horizontal">
              <Image
                Width="16"
                Height="16"
                Margin="0,0,4,0"
                Source="pack://application:,,,/Assets/remove_contact_32x32.png"
              />
              <TextBlock Text="Remove" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Grid>
    </Grid>
    <!-- GridSplitter - разделитель -->
    <GridSplitter
      Grid.Column="1"
      Width="3"
      HorizontalAlignment="Stretch"
      Background="White"
      ResizeBehavior="BasedOnAlignment"
    />
    <!-- ПРАВАЯ ПАНЕЛЬ - Детали контакта (белый фон) -->
    <Grid Grid.Column="2" Background="White">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="50" />
          <!-- Отступ перед Apply -->
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Заголовок -->
        <TextBlock
          Grid.Row="0"
          Text="Детали контакта"
          FontWeight="Bold"
          FontSize="14"
          Margin="0,0,0,16"
        />
        <!-- Пользовательский элемент управления с данными контакта -->
        <controls:ContactControl Grid.Row="1" DataContext="{Binding EditingContact}" />
        <!-- Кнопка Apply -->
        <Button
          Grid.Row="3"
          Command="{Binding ApplyCommand}"
          Visibility="{Binding IsApplyVisible, Converter={StaticResource VisibilityConverter}}"
          Width="75"
          Height="25"
          HorizontalAlignment="Left"
          Style="{StaticResource ActionButtonStyle}"
          ToolTip="Применить изменения"
        >
          <StackPanel Orientation="Horizontal">
            <Image
              Width="16"
              Height="16"
              Margin="0,0,4,0"
              Source="pack://application:,,,/Assets/collapse_32x32.png"
            />
            <TextBlock Text="Apply" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>
