<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Contacts</RootNamespace>
    <AssemblyName>Contacts</AssemblyName>
    <ApplicationIcon>contacts.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contacts.Model\Contacts.Model.csproj" />
    <ProjectReference Include="..\Contacts.ViewModel\Contacts.ViewModel.csproj" />
  </ItemGroup>
</Project>
