<Window
  x:Class="Contacts.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewmodel="clr-namespace:Contacts.ViewModel"
  xmlns:converters="clr-namespace:Contacts.Converters"
  xmlns:controls="clr-namespace:Contacts.Controls"
  mc:Ignorable="d"
  Title="Контакты"
  Height="500"
  Width="800"
  WindowStartupLocation="CenterScreen"
>
  <Window.Resources>
    <!-- Конвертер для видимости кнопки Apply -->
    <converters:VisibilityConverter x:Key="VisibilityConverter" />
    <!-- Шаблон элемента списка контактов -->
    <DataTemplate x:Key="ContactTemplate">
      <StackPanel Margin="3">
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="{Binding PhoneNumber}" FontSize="10" Foreground="#FF666666" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="0">
    <!-- Определяем колонки с GridSplitter -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="200" />
      <ColumnDefinition Width="5" />
      <!-- Ширина сплиттера -->
      <ColumnDefinition Width="2*" MinWidth="300" />
    </Grid.ColumnDefinitions>
    <!-- ЛЕВАЯ ПАНЕЛЬ - Список контактов (светло-серый фон) -->
    <Grid Grid.Column="0" Background="#F8F8F8">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Поиск -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="Поиск:" Margin="0,0,0,3" FontSize="12" />
          <TextBox
            x:Name="SearchBox"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            Height="25"
            Padding="3"
          >
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Background" Value="White" />
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Value=""
                  >
                    <Setter Property="Background" Value="#FFF8F8F8" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
        </StackPanel>
        <!-- Заголовок списка -->
        <TextBlock
          Grid.Row="1"
          Text="Список контактов"
          FontWeight="Bold"
          FontSize="14"
          Margin="0,0,0,8"
        />
        <!-- Список контактов -->
        <ListBox
          Grid.Row="2"
          ItemsSource="{Binding Contacts}"
          SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
          ItemTemplate="{StaticResource ContactTemplate}"
          Margin="0,0,0,8"
        />
        <!-- Кнопки управления -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
          <Button
            Content="Add"
            Command="{Binding AddCommand}"
            Width="Auto"
            Height="25"
            Margin="0,0,3,0"
            Padding="10,0"
          />
          <Button
            Content="Edit"
            Command="{Binding EditCommand}"
            Width="Auto"
            Height="25"
            Margin="0,0,3,0"
            Padding="10,0"
          />
          <Button
            Content="Remove"
            Command="{Binding RemoveCommand}"
            Width="Auto"
            Height="25"
            Padding="10,0"
          />
        </StackPanel>
      </Grid>
    </Grid>
    <!-- GridSplitter - разделитель -->
    <GridSplitter
      Grid.Column="1"
      Width="3"
      HorizontalAlignment="Stretch"
      Background="White"
      ResizeBehavior="BasedOnAlignment"
    />
    <!-- ПРАВАЯ ПАНЕЛЬ - Детали контакта (белый фон) -->
    <Grid Grid.Column="2" Background="White">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="50" />
          <!-- Отступ перед Apply -->
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Заголовок -->
        <TextBlock
          Grid.Row="0"
          Text="Детали контакта"
          FontWeight="Bold"
          FontSize="14"
          Margin="0,0,0,16"
        />
        <!-- Пользовательский элемент управления с данными контакта -->
        <controls:ContactControl Grid.Row="1" DataContext="{Binding EditingContact}" />
        <!-- Кнопка Apply -->
        <Button
          Grid.Row="3"
          Content="Apply"
          Command="{Binding ApplyCommand}"
          Width="75"
          Height="25"
          HorizontalAlignment="Left"
        />
      </Grid>
    </Grid>
  </Grid>
</Window>
